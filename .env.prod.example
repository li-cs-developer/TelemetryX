DEBUG=0
SECRET_KEY=replace-with-openssl-rand-hex-32
ALLOWED_HOSTS=telemetryx.example.com

# External MySQL (RDS or self-hosted)
DATABASE_URL=mysql://user:pass@db-host:3306/telemetryx

# Real AWS DynamoDB — endpoint MUST be empty
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=
DYNAMODB_TABLE=TelemetryXTelemetryProd

# Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CHANNEL_LAYERS_REDIS=redis://redis:6379/2

# Batch ingestion — turn ON in prod
BATCH_INGESTION_ENABLED=1

# Health check
HEALTHCHECK_TOKEN=